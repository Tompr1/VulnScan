# v0cday master — the only entry point of the platform (ports 80/443).
#
# - HTTPS everywhere: Let's Encrypt for a public domain name (CADDY_TLS =
#   your e-mail address), or Caddy's own CA for a lab or a bare IP
#   (CADDY_TLS = internal; probes then trust it with --ca-bundle, see
#   deploy/master/README.md).
# - The web UI is the built single-page app (hash routes: only "/" and the
#   built assets are files); every other path goes to the API, so a new API
#   route needs no change here.
{
	http_port {$HTTP_PORT:80}
	https_port {$HTTPS_PORT:443}
	admin off
	# Browsers send no SNI for an IP address (RFC 6066): without this, Caddy
	# has no certificate to present and resets the handshake ("internal error").
	default_sni {$PUBLIC_HOST}
}

{$PUBLIC_HOST} {
	tls {$CADDY_TLS:internal}
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		# The UI loads its fonts from Google Fonts and sets inline styles.
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob:; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
		-Server
	}

	# Only the entry point and the hashed files Vite emits under /assets are
	# static. The rest of /assets is API: /assets/from-hosts, /assets/12,
	# /assets/12/targets must reach the backend, not the file server.
	@ui path_regexp ui ^(/|/index\.html|/assets/[^/]+\.(js|css|map|svg|png|jpe?g|webp|gif|ico|woff2?|ttf|eot|json))$
	handle @ui {
		root * {$WEB_ROOT:/srv}
		@immutable path_regexp immutable ^/assets/[^/]+\.(js|css|map|svg|png|jpe?g|webp|gif|ico|woff2?|ttf|eot|json)$
		header @immutable Cache-Control "public, max-age=31536000, immutable"
		header /index.html Cache-Control "no-cache"
		header / Cache-Control "no-cache"
		file_server
	}

	handle {
		# Reports and dataset uploads can be large; probe reports too.
		request_body {
			max_size 200MB
		}
		reverse_proxy {$BACKEND_UPSTREAM:backend:8888} {
			# Long polls of the probes last up to 30 s, AI and report
			# generation longer.
			transport http {
				read_timeout 15m
			}
		}
	}

	log {
		output stdout
		format console
	}
}
